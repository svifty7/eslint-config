{
  "name": "@svifty7/eslint-config",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@10.32.1",
  "description": "ESLint config by svifty7 based on @antfu/eslint-config",
  "author": "svifty7 (https://github.com/svifty7)",
  "license": "MIT",
  "homepage": "https://github.com/svifty7/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svifty7/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/svifty7/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nr gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "nlx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && nlx @eslint/config-inspector build",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp && pnpm publish",
    "prepare": "simple-git-hooks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@unocss/eslint-plugin": "^66.12.0",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jsonc-eslint-parser": "^3.3.0",
    "pnpm-workspace-yaml": "^1.9.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.72.1",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "@prettier/plugin-xml": {
      "optional": true
    },
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": false
    },
    "eslint-plugin-format": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "jsonc-eslint-parser": {
      "optional": true
    },
    "pnpm-workspace-yaml": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-command": "^3.5.2",
    "eslint-plugin-import-lite": "^0.5.2",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-pnpm": "^1.9.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-yml": "^3.9.0",
    "eslint-processor-vue-blocks": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/config-inspector": "^1.5.0",
    "@types/node": "^25.9.9",
    "bumpp": "^11.0.1",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "nano-staged": "^0.9.0",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.21.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "volta": {
    "pnpm": "10.32.1",
    "node": "24.21.0"
  },
  "inlinedDependencies": {
    "@es-joy/jsdoccomment": "0.84.0",
    "comment-parser": "1.4.5",
    "eslint-plugin-command": "3.5.2",
    "esquery": "1.7.0",
    "jsdoc-type-pratt-parser": "7.1.1"
  }
}
