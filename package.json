{
  "name": "@svifty7/eslint-config",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@10.32.1",
  "description": "ESLint config by svifty7 based on @antfu/eslint-config",
  "author": "svifty7 (https://github.com/svifty7)",
  "license": "MIT",
  "homepage": "https://github.com/svifty7/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svifty7/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/svifty7/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build": "nr gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "eslint-config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && eslint-config-inspector build --config eslint.config.ts --out-dir .eslint-config-inspector",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp && pnpm publish",
    "prepare": "simple-git-hooks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@unocss/eslint-plugin": "^66.6.6",
    "eslint": "^10.4.0",
    "vue": "^3.5.14"
  },
  "peerDependenciesMeta": {
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": false
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.1.0",
    "@clack/prompts": "^1.8.1",
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-pnpm": "^1.9.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "eslint-plugin-yml": "^3.9.0",
    "find-up-simple": "^1.0.1",
    "globals": "^17.13.0",
    "jsonc-eslint-parser": "^3.3.0",
    "local-pkg": "^1.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "toml-eslint-parser": "^1.0.3",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^25.9.9",
    "bumpp": "^12.3.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "volta": {
    "pnpm": "10.32.1",
    "node": "24.22.1"
  }
}
