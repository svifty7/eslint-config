{
  "name": "@svifty7/eslint-config",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@10.10.0",
  "description": "ESLint config by svifty7 based on @antfu/eslint-config",
  "author": "svifty7 (https://github.com/svifty7)",
  "license": "MIT",
  "homepage": "https://github.com/svifty7/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svifty7/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/svifty7/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nlx @eslint/config-inspector --config eslint.config.ts",
    "build": "nr gen && tsdown",
    "build:inspector": "pnpm build && nlx @eslint/config-inspector build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp && pnpm publish",
    "prepare": "simple-git-hooks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "eslint": "^9.26.0",
    "vue": "^3.5.14"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/markdown": "^7.5.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/eslint-plugin": "^1.6.4",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-flat-config-utils": "^2.1.4",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.1.1",
    "eslint-plugin-command": "^3.4.0",
    "eslint-plugin-format": "^1.1.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.1.0",
    "eslint-plugin-pnpm": "^1.4.3",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-toml": "^0.12.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^10.6.2",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "eslint-plugin-yml": "^1.19.1",
    "globals": "^16.5.0",
    "jsonc-eslint-parser": "^2.4.2",
    "local-pkg": "^1.1.2",
    "pnpm-workspace-yaml": "^1.4.3",
    "prettier": "^3.7.4",
    "toml-eslint-parser": "^0.10.1",
    "vue-eslint-parser": "^10.2.0",
    "yaml-eslint-parser": "^1.3.2"
  },
  "devDependencies": {
    "@antfu/ni": "^28.0.0",
    "@eslint/config-inspector": "^1.4.2",
    "@types/node": "^22.19.3",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "eslint-typegen": "^2.3.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "tinyglobby": "^0.2.15",
    "tsdown": "^0.18.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.26"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
