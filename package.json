{
  "name": "@svifty7/eslint-config",
  "type": "module",
  "version": "0.0.11",
  "packageManager": "pnpm@10.32.1",
  "description": "ESLint config by svifty7 based on @antfu/eslint-config",
  "author": "svifty7 (https://github.com/svifty7)",
  "license": "MIT",
  "homepage": "https://github.com/svifty7/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svifty7/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/svifty7/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nlx @eslint/config-inspector --config eslint.config.ts",
    "build": "tsdown",
    "build:inspector": "pnpm build && nlx @eslint/config-inspector build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "prepack": "nr build",
    "release": "bumpp && pnpm publish",
    "prepare": "simple-git-hooks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@eslint-react/eslint-plugin": "^2.11.0",
    "@next/eslint-plugin-next": ">=15.0.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@unocss/eslint-plugin": ">=0.50.0",
    "astro-eslint-parser": "^1.0.2",
    "eslint": "^9.10.0 || ^10.0.0",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-format": ">=0.1.0",
    "eslint-plugin-jsx-a11y": ">=6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-solid": "^0.14.3",
    "eslint-plugin-svelte": ">=2.35.1",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-slidev": "^1.0.5",
    "svelte-eslint-parser": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "@angular-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin-template": {
      "optional": true
    },
    "@angular-eslint/template-parser": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "@prettier/plugin-xml": {
      "optional": true
    },
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-format": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-solid": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-slidev": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^7.7.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.5.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.0",
    "eslint": "^10.0.3",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.30"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "volta": {
    "node": "24.13.0",
    "pnpm": "10.32.1"
  }
}
