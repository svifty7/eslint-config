{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["./fixtures/**/*.*", "./_fixtures/**/*.*", "./antfu/**/*.*", ".eslint-config-inspector"]
}
